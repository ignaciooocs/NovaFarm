# Copy this file to .env and adjust values for your local setup.
# .env is gitignored — never commit real credentials.

# Credentials for the local Mongo container defined in docker-compose.yml.
# docker-compose reads these automatically from a .env file in this directory.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_INITDB_DATABASE=anotaya

# Connection string used by the NestJS app when running directly on the host
# (pnpm start:dev) — must match the values above. When running via
# `docker-compose up`, the server-app service overrides this itself to reach
# the "mongo" container by its service name instead of localhost.
MONGODB_URI_ATLAS=mongodb://admin:admin123@localhost:27017/anotaya?authSource=admin
