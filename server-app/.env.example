# Copy this file to .env and adjust values for your local setup.
# .env is gitignored — never commit real credentials.

# Credentials for the local Mongo container defined in docker-compose.yml.
# docker-compose reads these automatically from a .env file in this directory.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_INITDB_DATABASE=novafarm

# Connection string used by the NestJS app when running directly on the host
# (pnpm start:dev) — must match the values above. When running via
# `docker-compose up`, the server-app service overrides this itself to reach
# the "mongo" container by its service name instead of localhost.
MONGODB_URI_ATLAS=mongodb://admin:admin123@localhost:27017/novafarm?authSource=admin

# Firebase Admin SDK credentials — used by server-app to verify ID tokens
# issued by Firebase Authentication (ui-app authenticates directly against
# Firebase; server-app only validates). Get these three values from Firebase
# Console > Project Settings > Service Accounts > Generate new private key.
# FIREBASE_PRIVATE_KEY keeps its \n escaped inside the .env file.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
