# Config del proyecto de Firebase (cliente) — no es secreta, ver lib/firebase.ts
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# server-app local — usado por api/axios-instance.ts y por pnpm generate:api.
# Sin /api/v1 al final: el cliente generado por orval ya incluye ese prefijo
# en cada ruta (viene del spec de Swagger, que ya refleja el global prefix de
# server-app) — agregarlo acá también duplica la ruta y da 404.
# En un dispositivo físico (Expo Go), esto tiene que ser la IP de LAN de tu
# compu, no localhost — el celular no puede resolver "localhost" a tu compu.
EXPO_PUBLIC_API_URL=http://localhost:3000
ANOTAYA_API_SPEC_URL=http://localhost:3000/api-docs-json
